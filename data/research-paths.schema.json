{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akira-l.github.io/data/research-paths.schema.json",
  "title": "Yuanzhi Liang Research Paths",
  "type": "object",
  "required": ["schema_version", "hub", "paths"],
  "properties": {
    "schema_version": {"const": 1},
    "hub": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/hub"}
      ]
    },
    "paths": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/path"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "localizedHub": {
      "type": "object",
      "required": [
        "title", "dek", "profile_paragraphs", "intro",
        "arc_title", "arc_intro",
        "horizon_title", "horizon_intro", "horizon_closing",
        "methodology_title", "methodology_intro",
        "adjacent_title", "adjacent_intro", "closing"
      ],
      "properties": {
        "title": {"type": "string", "minLength": 4},
        "dek": {"type": "string", "minLength": 50},
        "profile_paragraphs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "string", "minLength": 100}
        },
        "intro": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {"type": "string", "minLength": 100}
        },
        "arc_title": {"type": "string", "minLength": 8},
        "arc_intro": {"type": "string", "minLength": 100},
        "horizon_title": {"type": "string", "minLength": 8},
        "horizon_intro": {"type": "string", "minLength": 100},
        "horizon_closing": {"type": "string", "minLength": 100},
        "methodology_title": {"type": "string", "minLength": 8},
        "methodology_intro": {"type": "string", "minLength": 100},
        "adjacent_title": {"type": "string", "minLength": 8},
        "adjacent_intro": {"type": "string", "minLength": 80},
        "closing": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {"type": "string", "minLength": 100}
        }
      },
      "additionalProperties": false
    },
    "localizedLabel": {
      "type": "object",
      "required": ["heading", "text"],
      "properties": {
        "heading": {"type": "string", "minLength": 4},
        "text": {"type": "string", "minLength": 80}
      },
      "additionalProperties": false
    },
    "methodologyItem": {
      "type": "object",
      "required": ["key", "paper_slugs", "en", "zh"],
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "paper_slugs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
        },
        "en": {"$ref": "#/$defs/localizedLabel"},
        "zh": {"$ref": "#/$defs/localizedLabel"}
      },
      "additionalProperties": false
    },
    "adjacentItem": {
      "type": "object",
      "required": ["paper_slug", "en", "zh"],
      "properties": {
        "paper_slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "en": {"type": "string", "minLength": 80},
        "zh": {"type": "string", "minLength": 30}
      },
      "additionalProperties": false
    },
    "hub": {
      "type": "object",
      "required": [
        "status", "drafted_on", "en", "zh", "arc", "horizon", "methodology", "adjacent"
      ],
      "properties": {
        "status": {"enum": ["ready_for_review", "published"]},
        "drafted_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "published_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "en": {"$ref": "#/$defs/localizedHub"},
        "zh": {"$ref": "#/$defs/localizedHub"},
        "arc": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/methodologyItem"}
        },
        "horizon": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/methodologyItem"}
        },
        "methodology": {
          "type": "array",
          "minItems": 5,
          "items": {"$ref": "#/$defs/methodologyItem"}
        },
        "adjacent": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/adjacentItem"}
        }
      },
      "additionalProperties": false
    },
    "localizedStage": {
      "type": "object",
      "required": ["key", "heading", "paragraphs"],
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "heading": {"type": "string", "minLength": 8},
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {"type": "string", "minLength": 100}
        }
      },
      "additionalProperties": false
    },
    "localizedSection": {
      "type": "object",
      "required": ["heading", "paragraphs"],
      "properties": {
        "heading": {"type": "string", "minLength": 8},
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {"type": "string", "minLength": 100}
        }
      },
      "additionalProperties": false
    },
    "localizedPath": {
      "type": "object",
      "required": [
        "title", "short_title", "dek", "question", "thesis", "intro",
        "stages", "boundaries", "open_questions"
      ],
      "properties": {
        "title": {"type": "string", "minLength": 12},
        "short_title": {"type": "string", "minLength": 5},
        "dek": {"type": "string", "minLength": 70},
        "question": {"type": "string", "minLength": 50},
        "thesis": {"type": "string", "minLength": 80},
        "intro": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {"type": "string", "minLength": 120}
        },
        "stages": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {"$ref": "#/$defs/localizedStage"}
        },
        "boundaries": {"$ref": "#/$defs/localizedSection"},
        "open_questions": {"$ref": "#/$defs/localizedSection"}
      },
      "additionalProperties": false
    },
    "member": {
      "type": "object",
      "required": ["paper_slug", "role", "stage_key", "en_relation", "zh_relation"],
      "properties": {
        "paper_slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "role": {"enum": ["foundation", "core", "bridge", "framing", "horizon"]},
        "stage_key": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "en_relation": {"type": "string", "minLength": 60},
        "zh_relation": {"type": "string", "minLength": 25}
      },
      "additionalProperties": false
    },
    "path": {
      "type": "object",
      "required": ["slug", "order", "status", "drafted_on", "members", "en", "zh"],
      "properties": {
        "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "order": {"type": "integer", "minimum": 1, "maximum": 3},
        "status": {"enum": ["ready_for_review", "published"]},
        "drafted_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "published_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "members": {
          "type": "array",
          "minItems": 5,
          "items": {"$ref": "#/$defs/member"}
        },
        "en": {"$ref": "#/$defs/localizedPath"},
        "zh": {"$ref": "#/$defs/localizedPath"}
      },
      "additionalProperties": false
    }
  }
}
