{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akira-l.github.io/data/publications.schema.json",
  "title": "Yuanzhi Liang publication records",
  "type": "object",
  "required": ["schema_version", "papers"],
  "properties": {
    "schema_version": {"const": 1},
    "papers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/paper"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "localized": {
      "type": "object",
      "required": [
        "summary",
        "problem",
        "contributions",
        "evidence",
        "limitations",
        "positioning",
        "citation_ready"
      ],
      "properties": {
        "summary": {"type": "string", "minLength": 30},
        "problem": {"type": "string", "minLength": 30},
        "contributions": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 15}
        },
        "evidence": {"type": "string", "minLength": 30},
        "limitations": {"type": "string", "minLength": 30},
        "positioning": {"type": "string", "minLength": 30},
        "citation_ready": {"type": "string", "minLength": 30}
      },
      "additionalProperties": false
    },
    "link": {
      "type": "object",
      "required": ["label", "url"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["label", "url", "version", "method_locator", "evidence_locator"],
      "properties": {
        "label": {"type": "string", "minLength": 3},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "version": {"type": "string", "minLength": 3},
        "method_locator": {"type": "string", "minLength": 3},
        "evidence_locator": {"type": "string", "minLength": 3}
      },
      "additionalProperties": false
    },
    "alternatePagination": {
      "type": "object",
      "required": ["pages", "version", "url"],
      "properties": {
        "pages": {"type": "string", "pattern": "^\\d+(?:-\\d+)?$"},
        "version": {"type": "string", "minLength": 3},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"}
      },
      "additionalProperties": false
    },
    "paper": {
      "type": "object",
      "required": [
        "slug",
        "short_title",
        "title",
        "citation_key",
        "authors",
        "kind",
        "venue",
        "year",
        "publication_date",
        "keywords",
        "abstract",
        "source",
        "source_checked",
        "verification_status",
        "links",
        "en",
        "zh"
      ],
      "properties": {
        "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "short_title": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 10},
        "citation_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "authors": {
          "type": "array",
          "minItems": 1,
          "contains": {"const": "Yuanzhi Liang"},
          "items": {"type": "string", "minLength": 3}
        },
        "kind": {"enum": ["journal", "conference", "preprint"]},
        "venue": {"type": "string", "minLength": 2},
        "citation_container_title": {"type": "string", "minLength": 2},
        "publication_status": {"enum": ["published", "forthcoming", "preprint"]},
        "publisher": {"type": "string", "minLength": 2},
        "editors": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 3}
        },
        "year": {"type": "integer", "minimum": 1900, "maximum": 2100},
        "publication_date": {
          "type": "string",
          "pattern": "^\\d{4}(?:-\\d{2}(?:-\\d{2})?)?$"
        },
        "online_date": {"type": "string", "format": "date"},
        "print_date": {"type": "string", "format": "date"},
        "volume": {"type": "string"},
        "issue": {"type": "string"},
        "article_number": {"type": "string", "pattern": "^\\d+$"},
        "pages": {"type": "string", "pattern": "^\\d+(?:-\\d+)?$"},
        "doi": {"type": "string", "pattern": "^10\\."},
        "arxiv_id": {"type": "string", "pattern": "^\\d{4}\\.\\d{4,5}$"},
        "arxiv_primary_class": {"type": "string", "pattern": "^[a-z-]+\\.[A-Za-z-]+$"},
        "arxiv_posted": {"type": "string", "format": "date"},
        "arxiv_updated": {"type": "string", "format": "date"},
        "bibliographic_note": {"type": "string", "minLength": 30},
        "alternate_pagination": {"$ref": "#/$defs/alternatePagination"},
        "keywords": {
          "type": "array",
          "minItems": 3,
          "items": {"type": "string", "minLength": 2}
        },
        "abstract": {"type": "string", "minLength": 150},
        "source": {"$ref": "#/$defs/source"},
        "source_checked": {"type": "string", "format": "date"},
        "verification_status": {
          "enum": ["pending-author-review", "author-verified"]
        },
        "author_verified_on": {"type": "string", "format": "date"},
        "links": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/link"}
        },
        "og_image": {"type": "string"},
        "en": {"$ref": "#/$defs/localized"},
        "zh": {"$ref": "#/$defs/localized"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verification_status": {"const": "author-verified"}
            }
          },
          "then": {"required": ["author_verified_on"]}
        },
        {
          "if": {"required": ["arxiv_id"]},
          "then": {"required": ["arxiv_primary_class"]}
        },
        {
          "not": {"required": ["pages", "article_number"]}
        }
      ],
      "additionalProperties": false
    }
  }
}
